# Copy to apps/web/.env.local and fill in. NEVER commit the real values.

# Supabase project — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Postgres connection used by the engine (server-only).
# Use the Supabase *Session pooler* URL (Dashboard → Connect → Session pooler).
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Square webhook (Phase 5) — server-only secrets, NEVER commit real values.
# Signature key: Square Dashboard → Developer → your app → Webhooks → subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=YOUR-WEBHOOK-SIGNATURE-KEY
# The EXACT notification URL configured on the subscription (must match
# byte-for-byte; the signature is HMAC over this URL + the raw body).
SQUARE_WEBHOOK_NOTIFICATION_URL=https://YOUR-DOMAIN/api/square/webhook
