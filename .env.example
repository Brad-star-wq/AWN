# Postgres connection string for the resale engine (Supabase or any Postgres).
#
# Supabase: Project Settings → Database → Connection string.
#   • Use the connection pooler URL for serverless/short-lived runs
#     (host ends in .pooler.supabase.com). The client sets prepare:false,
#     which is required by the transaction pooler.
#   • SSL is required by default. For a local Postgres with no SSL, append
#     ?sslmode=disable to the URL (or set DATABASE_SSL=disable).
#
# NEVER commit the real .env — only this example. (.env is gitignored.)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Optional: only for a local Postgres without TLS.
# DATABASE_SSL=disable
